# Server Port
PORT=3000

# Google Gemini API Configuration (Gemini 3.1 Flash Lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# webcmd Configuration
WEBCMD_PORT=9777
WEBCMD_WINDOW=foreground

# Optional: Path to custom Chromium / Cloak executable
# CHROME_PATH=C:\path\to\chromium\chrome.exe
